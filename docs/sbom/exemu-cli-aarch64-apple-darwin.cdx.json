        "version": "1"
      }
    ],
    "properties": [
      {
        "name": "exemu:sbom:target",
        "value": "aarch64-apple-darwin"
      },
      {
        "name": "exemu:sbom:scope",
        "value": "shipping closure \u2014 default cargo features, normal and build dependency edges only; dev-dependencies and off-by-default optional features excluded"
      },
      {
        "name": "exemu:sbom:wine-components",
        "value": "0"
      },
      {
        "name": "exemu:compliance:wine-runtime",
        "value": "Wine's PE builtin DLLs (LGPL-2.1-or-later) are NOT a cargo dependency and are absent from this document by construction: exemu loads them at runtime as separate guest image files through its own PE loader, and never links or compiles Wine code into any exemu crate. Their redistribution obligations are tracked separately in docs/COMPLIANCE.md."
      },
      {
        "name": "exemu:compliance:copyleft-in-shipping-closure",
        "value": "none \u2014 enforced by `cargo deny --config deny.toml check licenses`"
      }
    ]
  },
